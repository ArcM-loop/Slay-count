rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ═══════════════════════════════════════════════════════════════
    // HELPER FUNCTIONS
    // ═══════════════════════════════════════════════════════════════

    // Cek apakah request berasal dari user yang login
    function isAuthenticated() {
      return request.auth != null;
    }

    // Cek apakah dokumen milik user yang sedang login
    function isOwner() {
      return isAuthenticated() && resource.data.user_id == request.auth.uid;
    }

    // Cek apakah data baru yang akan ditulis punya user_id yang benar
    function isValidOwner() {
      return isAuthenticated() && request.resource.data.user_id == request.auth.uid;
    }

    // ═══════════════════════════════════════════════════════════════
    // KOLEKSI UTAMA — Akses normal (baca & tulis via client)
    // ═══════════════════════════════════════════════════════════════

    match /businesses/{docId} {
      allow read:   if isAuthenticated() && resource.data.user_id == request.auth.uid;
      allow create: if isValidOwner();
      allow update: if isOwner();
      allow delete: if isOwner();
    }

    match /transactions/{docId} {
      allow read:   if isAuthenticated() && resource.data.user_id == request.auth.uid;
      allow create: if isValidOwner();
      allow update: if isOwner();
      allow delete: if isOwner();
    }

    match /accounts/{docId} {
      allow read:   if isAuthenticated() && resource.data.user_id == request.auth.uid;
      allow create: if isValidOwner();
      allow update: if isOwner();
      allow delete: if isOwner();
    }

    match /fixed_assets/{docId} {
      allow read:   if isAuthenticated() && resource.data.user_id == request.auth.uid;
      allow create: if isValidOwner();
      allow update: if isOwner();
      allow delete: if isOwner();
    }

    match /purchase_orders/{docId} {
      allow read:   if isAuthenticated() && resource.data.user_id == request.auth.uid;
      allow create: if isValidOwner();
      allow update: if isOwner();
      allow delete: if isOwner();
    }

    match /period_closings/{docId} {
      allow read:   if isAuthenticated() && resource.data.user_id == request.auth.uid;
      allow create: if isValidOwner();
      // Period closings tidak boleh dihapus atau diubah setelah dibuat
      allow update: if false;
      allow delete: if false;
    }

    // ═══════════════════════════════════════════════════════════════
    // JOURNAL ENTRIES — HANYA BISA DIBACA, TIDAK BISA DITULIS DARI CLIENT
    // Penulisan HANYA dilakukan oleh backend via Firebase Admin SDK
    // (Admin SDK secara otomatis bypass semua Firestore Rules)
    // ═══════════════════════════════════════════════════════════════
    match /journal_entries/{docId} {
      allow read:   if isAuthenticated() && resource.data.user_id == request.auth.uid;
      allow create: if isValidOwner();  // Mengizinkan penulisan dari client (untuk Jurnal Manual, PO, Bank Rec)
      allow update: if isOwner();       // Mengizinkan pembaruan oleh pemilik terverifikasi
      allow delete: if isOwner();       // Mengizinkan penghapusan oleh pemilik (misalnya saat membatalkan/mengedit)
    }

    // ═══════════════════════════════════════════════════════════════
    // AUDIT LOGS — APPEND-ONLY, TIDAK BISA DIUBAH ATAU DIHAPUS
    // ═══════════════════════════════════════════════════════════════
    match /audit_logs/{docId} {
      allow read:   if isAuthenticated() && (resource.data.userId == request.auth.uid || resource.data.user_id == request.auth.uid);
      allow create: if isAuthenticated() && request.resource.data.userId == request.auth.uid;
      allow update: if false;  // DIBLOKIR — log tidak boleh diubah
      allow delete: if false;  // DIBLOKIR — log tidak boleh dihapus (immutable)
    }
    // ═══════════════════════════════════════════════════════════════
    // USER ROLES — Akses aman dengan pencegahan Privilege Escalation
    // ═══════════════════════════════════════════════════════════════
    match /user_roles/{uid} {
      allow read:   if isAuthenticated() && uid == request.auth.uid;
      // Hanya izinkan user membuat/mengupdate role mereka sendiri sebagai 'user'
      // Perubahan ke role 'admin' atau 'developer' harus dilakukan via Firebase Console / Admin SDK
      allow create, update: if isAuthenticated() && uid == request.auth.uid 
                            && request.resource.data.role == 'user' 
                            && request.resource.data.actualRole == 'user';
      allow delete: if false;
    }
  }
}
